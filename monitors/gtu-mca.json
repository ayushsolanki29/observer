      },
      {
        "keyword": "Recheck",
        "score": 5
      },
      {
        "keyword": "Reassessment",
        "score": 5
      },
      {
        "keyword": "Exam",
        "score": 5
      },
      {
        "keyword": "Examination",
        "score": 5
      },
      {
        "keyword": "Practical",
        "score": 5
      },
      {
        "keyword": "Time Table",
        "score": 5
      },
      {
        "keyword": "Schedule",
        "score": 5
      },
      {
        "keyword": "Reschedule",
        "score": 5
      }
