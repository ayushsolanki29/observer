{
  "version": 1,
  "id": "gtu-mca",
  "name": "GTU MCA (2024-2026)",
  "description": "Monitors GTU for regular Master of Computer Applications (MCA) circulars.",
  "enabled": true,
  "tags": ["university", "gtu", "mca"],
  "website": {
    "url": "https://www.gtu.ac.in/",
