    "mustNotMatch": [
      "Integrated",
      "Master of Computer Applications (Integrated)",
      "BCA",
      "Bachelor of Computer Applications",
      "Civil",
      "Mechanical",
      "Electrical",
      "Electronics",
      "Automobile",
      "Architecture",
      "Diploma",
      "B.E.",
